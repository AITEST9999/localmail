# Copy this file to .env. These values are local-development defaults only.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://localmail:localmail@localhost:5432/localmail
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=localmail
SMTP_INBOUND_PORT=2525
SMTP_OUTBOUND_HOST=localhost
SMTP_OUTBOUND_PORT=1025
SMTP_MAX_HOPS=20
SCHEDULED_SEND_POLL_INTERVAL_MS=5000
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_POD_RPS=50
RATE_LIMIT_POD_BURST=100
MAIL_DOMAIN=localmail.test
API_HOST=0.0.0.0
API_PORT=8080
ADMIN_API_KEY=lm_admin_change_me
# Optional dedicated HMAC key; falls back to ADMIN_API_KEY for local development.
ATTACHMENT_SIGNING_KEY=
# Generate for local use with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# drop = reject blocked senders at RCPT TO; spam = store with spam + skip_classify (no Jev)
SENDER_BLOCK_MODE=drop
JEV_ENABLED=false
# Optional; set only in your untracked .env when JEV_ENABLED=true.
TYPESAFE_API_KEY=
