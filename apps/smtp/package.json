{
  "name": "@localmail/smtp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/server.js",
    "test": "pnpm --filter @localmail/core build && pnpm --filter @localmail/db build && pnpm --filter @localmail/events build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@localmail/config": "workspace:^",
    "@localmail/core": "workspace:^",
    "@localmail/db": "workspace:^",
    "@localmail/events": "workspace:^",
    "drizzle-orm": "^0.38.3",
    "mailparser": "^3.9.28",
    "prom-client": "^15.1.3",
    "smtp-server": "^3.19.13"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/smtp-server": "^3.5.13",
    "tsx": "^4.19.2"
  }
}
