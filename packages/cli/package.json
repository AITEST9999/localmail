{
  "name": "@localmail/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "localmail": "./dist/index.js"
  },
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "test": "pnpm --filter @localmail/sdk build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@localmail/sdk": "workspace:*",
    "commander": "^15.0.0"
  }
}
